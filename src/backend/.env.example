# abgehakt pusher — ntfy config
# Copy to .env and fill in. .env is gitignored.

NTFY_URL=http://localhost:2586
NTFY_TOPIC=abgehakt

# ntfy user with write access to the topic (see ~/.openclaw/secure/ntfy-credentials)
NTFY_USER=admin
NTFY_PASSWORD=changeme

# Opened when tapping the notification
NTFY_CLICK_URL=http://localhost:8766/

# DB times are local wall-clock in this zone
APP_TIMEZONE=Europe/Berlin

# Poll every N seconds; suppress pushes older than N minutes
POLL_INTERVAL=30
GRACE_MINUTES=180
